{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 MSVC",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "cacheVariables": { "WEFT_BUILD_TESTS": "ON", "WEFT_BUILD_PROBES": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "portable-ninja",
      "displayName": "Ninja with an initialized host toolchain",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/portable-ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "WEFT_BUILD_TESTS": "ON", "WEFT_BUILD_PROBES": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "portable-debug", "configurePreset": "portable-ninja" }
  ],
  "testPresets": [
    { "name": "windows-debug", "configurePreset": "windows-msvc", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-msvc", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "portable-debug", "configurePreset": "portable-ninja", "output": { "outputOnFailure": true } }
  ]
}
