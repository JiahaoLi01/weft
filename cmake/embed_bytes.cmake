# Writes the bytes of INPUT (CRLF normalized to LF) to OUTPUT as a C/C++ initializer list ending with 0x00, for
#   constexpr char name[] = {
#   #include "OUTPUT"
#   };
# The output is rewritten only when its content changes, so unchanged sources do not rebuild.
#
# cmake -DINPUT=<file> -DOUTPUT=<file.inc> -P embed_bytes.cmake
if(NOT INPUT OR NOT OUTPUT)
    message(FATAL_ERROR "embed_bytes.cmake requires -DINPUT=<file> and -DOUTPUT=<file>")
endif()
file(READ "${INPUT}" hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
# CRLF becomes LF, so the embedded text does not depend on how the source was checked out.
string(REPLACE "0x0d,0x0a," "0x0a," bytes "${bytes}")
# Sixteen bytes per line.
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\\1\n" bytes "${bytes}")
get_filename_component(name "${INPUT}" NAME)
file(WRITE "${OUTPUT}.tmp" "// Generated by cmake/embed_bytes.cmake from ${name}; edit the source file.\n${bytes}0x00\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
