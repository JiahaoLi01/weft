# Writes the bytes of INPUT to OUTPUT as a C/C++ initializer list, for
#   constexpr unsigned char name[] = {
#   #include "OUTPUT"
#   };
# Text mode (the default) normalizes CRLF to LF and appends a terminating 0x00, so the embedded text does not
# depend on how the source was checked out. -DBINARY=ON copies the bytes unchanged without a terminator
# (compiled shader bytecode). The output is rewritten only when its content changes, so unchanged sources do
# not rebuild.
#
# cmake -DINPUT=<file> -DOUTPUT=<file.inc> [-DBINARY=ON] -P embed_bytes.cmake
if(NOT INPUT OR NOT OUTPUT)
    message(FATAL_ERROR "embed_bytes.cmake requires -DINPUT=<file> and -DOUTPUT=<file>")
endif()
file(READ "${INPUT}" hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
if(NOT BINARY)
    string(REPLACE "0x0d,0x0a," "0x0a," bytes "${bytes}")
endif()
# Sixteen bytes per line.
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\\1\n" bytes "${bytes}")
get_filename_component(name "${INPUT}" NAME)
if(BINARY)
    set(terminator "")
else()
    set(terminator "0x00\n")
endif()
file(WRITE "${OUTPUT}.tmp" "// Generated by cmake/embed_bytes.cmake from ${name}; edit the source file.\n${bytes}${terminator}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
